{% extends 'layouts/app.html.twig' %}

{% block title %}Mon coffre-fort{% endblock %}

{% block content %}

  {% set loggedUser = app.user ?? null %}
  {% if loggedUser and loggedUser.privateSecret == null %} 
    {% include 'app/vault/_redirect-to-private-secret-setup.html.twig' %}
  {% else %}

    {% include 'app/vault/_verify-token-modal.html.twig' %}

    <div id="vault-content" class="py-4 vault-secure-content">
      
      {% include 'components/_fab.html.twig' with { route: 'app_vault_journal_add', label: 'Nouvelle entrée privée' } only %}

      <div class="entry-list__empty" id="vault-entries-empty">
        <p class="text-muted">Aucune entrée pour l'instant.<br>Commencez à écrire !</p>
        <a href="{{ path('app_vault_journal_add') }}" class="btn btn-primary mt-3">
          <i class="ri-add-line me-1"></i> Nouvelle entrée privée
        </a>
      </div>

      {# 🟢 Remplacement de row g-4 par entry-masonry #}
      <div id="vault-entries-container" class="entry-masonry entry-list d-none">
        <div class="text-center py-5 text-muted w-100" style="column-span: all;">
          <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
          Déchiffrement en cours...
        </div>
      </div>

    </div>

  {% endif %}
  
{% endblock %}

{% block js %}
  <script src="{{ asset('js/pages/app/vault.js') }}"></script>
  <script src="{{ asset('js/pages/app/entry.js') }}"></script>
{% endblock %}