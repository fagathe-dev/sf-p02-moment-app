{# templates/app/journal/_form.html.twig #}

{% set is_edit = entry is not null and entry.id is not null %}
{% set api_url = is_edit
  ? path('app_journal_api_update', { id: entry.id })
  : path('app_journal_api_save') %}

<form
  id="journal-form"
  class="journal-form"
  data-url="{{ api_url }}"
  data-csrf="{{ csrf_token('journal_save') }}"
  data-redirect="{{ path('app_view_feed') }}"
  novalidate
>

  {# ── Titre ──────────────────────────────────────────────────────────────── #}
  <div class="journal-form__field">
    <input
      type="text"
      id="entry-title"
      name="title"
      class="journal-form__title-input"
      placeholder="Titre (optionnel)"
      value="{{ is_edit ? entry.title : '' }}"
      maxlength="200"
      autocomplete="off"
    >
  </div>

  {# ── Contenu Markdown (Devient la zone de Drag & Drop) ──────────────────── #}
  <div class="journal-form__field markdown-editor-wrapper js-upload-zone">
    
    <ul class="nav nav-tabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active js-md-tab" data-md-target="journal-editor-pane" type="button" role="tab" aria-selected="true">
          Écrire
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link js-md-tab js-md-preview-tab" data-md-target="journal-preview-pane" type="button" role="tab" aria-selected="false">
          Aperçu
        </button>
      </li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-3 bg-white">
      <div class="tab-pane fade show active js-md-pane" id="journal-editor-pane" role="tabpanel">
        <textarea
          id="entry-content"
          name="content"
          class="journal-form__editor js-md-textarea border-0 p-0 shadow-none w-100"
          style="outline: none; resize: vertical;"
          placeholder="Écrivez votre entrée… (Markdown supporté)"
          data-markdown="true"
          rows="12"
        >{{ is_edit ? entry.content : '' }}</textarea>
      </div>
      <div class="tab-pane fade js-md-pane" id="journal-preview-pane" role="tabpanel">
        <div class="js-md-preview-container markdown-body" style="min-height: 190px;">
          <em class="text-muted">Rien à prévisualiser.</em>
        </div>
      </div>
    </div>
  </div>

  {# ── Toolbar (Boutons d'actions synchronisés) ───────────────────────────── #}
  <div class="journal-form__toolbar d-flex flex-wrap align-items-center gap-2 mt-2">
    
    <!-- Trigger Mood -->
    <button type="button" class="journal-form__trigger-btn js-mood-trigger" data-bs-toggle="modal" data-bs-target="#journal-form_moodModal">
      {% if is_edit and entry.mood %}
        {{ entry.mood.emoji }}
      {% else %}
        <i class="ri-emotion-line" aria-hidden="true"></i>
      {% endif %}
    </button>

    <!-- Trigger Localisation -->
    <div class="journal-form__location js-location-field">
      <button type="button" class="journal-form__trigger-btn js-location-trigger">
        <i class="ri-map-pin-line" aria-hidden="true"></i>
        <span class="js-location-label">
          {% if is_edit and entry.location %}
            {{ entry.location.city ?? entry.location.name }}
          {% endif %}
        </span>
      </button>
      <input type="hidden" name="location_lat"  id="entry-location-lat"  value="{{ is_edit and entry.location ? entry.location.latitude : '' }}">
      <input type="hidden" name="location_lng"  id="entry-location-lng"  value="{{ is_edit and entry.location ? entry.location.longitude : '' }}">
      <input type="hidden" name="location_name" id="entry-location-name" value="{{ is_edit and entry.location ? entry.location.name : '' }}">
    </div>

    <!-- Trigger Catégorie -->
    <button type="button" class="journal-form__trigger-btn js-category-trigger" data-bs-toggle="modal" data-bs-target="#journal-form_categoryModal">
      {% if is_edit and entry.categories|length > 0 %}
        {% set firstCat = entry.categories|first %}
        {% if firstCat.color %}
          <span class="flex-shrink-0 border bg-{{ firstCat.color.value }}" style="width:12px;height:12px;border-radius:50%;"></span>
        {% endif %}
        <span class="fw-medium">{{ firstCat.name }}</span>
        {% if entry.categories|length > 1 %}
          <span class="badge bg-secondary ms-1">+{{ entry.categories|length - 1 }}</span>
        {% endif %}
      {% else %}
        <i class="ri-price-tag-3-line me-1" aria-hidden="true"></i> Catégorie
      {% endif %}
    </button>

    <!-- Trigger Couleur -->
    <button type="button" class="journal-form__trigger-btn p-1 js-color-trigger" data-bs-toggle="modal" data-bs-target="#journal-form_colorModal" title="Modifier la couleur de la card">
      <span class="color-circle {% if is_edit and entry.color %}bg-soft-{{ entry.color.value }}{% endif %}">
        <i class="ri-palette-line" aria-hidden="true"></i>
      </span>
    </button>

    <!-- 🟢 NOUVEAU Trigger Médias (Ouvre l'explorateur de fichiers sans modale) -->
    <label class="journal-form__trigger-btn mb-0 js-media-trigger" title="Ajouter des images/vidéos" style="cursor: pointer;">
      <i class="ri-image-line" aria-hidden="true"></i>
      <input type="file" id="entry-medias" name="medias[]" class="js-media-input d-none" multiple accept="image/*,video/*,audio/*">
    </label>

    {# ── Confidentialité ─────────────────────────────────────────────────────── #}
    <div class="form-check ms-auto d-flex align-items-center mb-0">
      <input
        type="checkbox"
        class="form-check-input mt-0 me-2"
        id="entry-is-private"
        name="is_private"
        value="1"
        {% if is_edit and entry.isPrivate %}checked{% endif %}
      >
      <label class="form-check-label mb-0 fw-medium text-body" for="entry-is-private">
        <i class="ri-lock-line me-1" aria-hidden="true"></i> Entrée confidentielle
      </label>
    </div>

  </div>

  {# ── 🟢 Plateau des pièces jointes (Affichés sous la toolbar) ───────────── #}
  <div class="journal-form__attachments mt-2">
    {% if is_edit and entry.entryMedia is not empty %}
      <div class="journal-form__existing-medias js-existing-medias">
        {% for media in entry.entryMedia %}
          <div class="journal-form__media-thumb" data-id="{{ media.id }}">
            {% if media.mimeType starts with 'image/' %}
              <img src="{{ asset(media.filePath) }}" alt="{{ media.originalName }}">
            {% elseif media.mimeType starts with 'video/' %}
              <i class="ri-video-line"></i>
            {% else %}
              <i class="ri-music-line"></i>
            {% endif %}
            <button type="button" class="journal-form__media-remove js-remove-existing-media" data-id="{{ media.id }}" aria-label="Supprimer">
              <i class="ri-close-line"></i>
            </button>
          </div>
        {% endfor %}
      </div>
    {% endif %}
    <div class="journal-form__previews js-media-previews"></div>
  </div>


  {# ── Modale Humeur ──────────────────────────────────────────────────────── #}
  <div class="modal fade" id="journal-form_moodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-body">
          <button type="button" class="btn-close position-absolute" data-bs-dismiss="modal" aria-label="Close" style="top: 12px; right: 12px; font-size: .8rem;"></button>
          <div class="journal-form__field">
            <label class="journal-form__label mb-3">
              <i class="ri-emotion-line me-1" aria-hidden="true"></i> Mood
            </label>
            <div class="journal-form__mood-grid js-mood-grid">
              {% for mood in moods %}
                <button
                  type="button"
                  class="journal-form__mood-btn js-mood-btn"
                  data-value="{{ mood.value }}"
                  title="{{ mood.label }}"
                  aria-pressed="{{ is_edit and entry.mood and entry.mood.value == mood.value ? 'true' : 'false' }}"
                >
                  {{ mood.emoji }}
                </button>
              {% endfor %}
              <input type="hidden" name="mood" id="entry-mood" value="{{ is_edit and entry.mood ? entry.mood.value : '' }}">
            </div>
            <div class="d-flex justify-content-end mt-4">
              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# ── Modale Catégorie ───────────────────────────────────────────────────── #}
  <div class="modal fade" id="journal-form_categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-body">
          <button type="button" class="btn-close position-absolute" data-bs-dismiss="modal" aria-label="Close" style="top: 12px; right: 12px; font-size: .8rem;"></button>
          {% if categories is not empty %}
            <div class="journal-form__field" id="journal-form__categories">
              <label class="journal-form__label d-flex justify-content-between align-items-center mb-3">
                <span><i class="ri-folder-line me-1" aria-hidden="true"></i> Catégories</span>
                <a href="{{ path('app_category_index') }}" class="text-decoration-none text-muted fs-13 fw-medium">
                  <i class="ri-edit-line align-bottom me-1"></i> Gérer
                </a>
              </label>
              <div class="d-flex flex-wrap gap-2 js-selectable-container form-selectable" data-mode="checkbox">
                {% for category in categories %}
                  <div class="form-selectable-item">
                    <input
                      type="checkbox"
                      class="form-selectable-input d-none"
                      name="categories[]"
                      id="entry-category-{{ category.id }}"
                      value="{{ category.id }}"
                      {% if is_edit and entry.categories.contains(category) %}checked{% endif %}
                    >
                    <label
                      class="form-selectable-label border rounded-pill px-3 py-1 d-flex align-items-center gap-2"
                      for="entry-category-{{ category.id }}"
                      style="cursor: pointer; user-select: none;"
                    >
                      {% if category.color %}
                        <span class="flex-shrink-0 pill border bg-{{ category.color.value }}" style="width:12px;height:12px;border-radius:50%;"></span>
                      {% endif %}
                      <span class="fw-medium text-body" style="font-size:14px;">{{ category.name }}</span>
                    </label>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
          <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# ── Modale Couleur ─────────────────────────────────────────────────────── #}
  <div class="modal fade" id="journal-form_colorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-body">
          <button type="button" class="btn-close position-absolute" data-bs-dismiss="modal" aria-label="Close" style="top: 12px; right: 12px; font-size: .8rem;"></button>
          <div class="journal-form__field mb-3">
            <label class="journal-form__label mb-3">
              <i class="ri-palette-line me-1" aria-hidden="true"></i> Couleur de la card
            </label>
            <div class="journal-form__color-grid js-selectable-container form-selectable" data-mode="radio">
              {% for color in colors %}
                <div class="form-selectable-item">
                  <input
                    type="radio"
                    class="form-selectable-input d-none"
                    name="color"
                    id="entry-color-{{ color.value }}"
                    value="{{ color.value }}"
                    {% if is_edit and entry.color and entry.color.value == color.value %}checked{% endif %}
                  >
                  <label class="form-selectable-label color-swatch bg-soft-{{ color.value }}" for="entry-color-{{ color.value }}" title="{{ color.value|capitalize }}"></label>
                </div>
              {% endfor %}
              <div class="form-selectable-item">
                <input
                  type="radio"
                  class="form-selectable-input d-none"
                  name="color"
                  id="entry-color-none"
                  value=""
                  {% if not is_edit or not entry.color %}checked{% endif %}
                >
                <label class="form-selectable-label color-swatch color-swatch--none" for="entry-color-none" title="Aucune couleur">
                  <i class="ri-close-line" aria-hidden="true"></i>
                </label>
              </div>
            </div>
          </div>
          <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# ── Actions ────────────────────────────────────────────────────────────── #}
  <div class="journal-form__actions mt-4 pt-3 border-top">
    <a href="{{ path('app_view_feed') }}" class="btn btn-light">Annuler</a>
    <button type="submit" class="btn btn-primary js-submit-btn">
      <span class="js-submit-label">{{ is_edit ? 'Mettre à jour' : 'Enregistrer' }}</span>
      <span class="js-submit-spinner d-none">
        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
        Enregistrement…
      </span>
    </button>
  </div>

</form>