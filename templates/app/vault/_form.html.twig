{{ form_start(form, {'attr': {'class': 'vault-form'}}) }}

  {{ form_errors(form) }}

  <div class="mb-3">
    {{ form_row(form.title) }}
  </div>

  <div class="mb-3">
    {{ form_row(form.content) }}
  </div>

  <div class="mb-3">
    {{ form_row(form.mood) }}
  </div>

  <div class="d-flex align-items-center gap-2 mt-4">
    {{ form_widget(form.save) }}
    <a href="{{ path('app_vault_journal_index') }}" class="btn btn-light">Annuler</a>
  </div>

{{ form_end(form) }}