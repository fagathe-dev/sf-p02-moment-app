{% extends 'layouts/app.html.twig' %}

{% block title %}Nouveau souvenir privé{% endblock %}

{% block content %}
  
  {% set loggedUser = app.user ?? null %}
  {% if loggedUser and loggedUser.privateSecret == null %} 
    {% include 'app/vault/_redirect-to-private-secret-setup.html.twig' %}
  {% else %}
    {# Inclusion de la modale #}
    {% include 'app/vault/_verify-token-modal.html.twig' %}

    {# Squelette en arrière-plan (flouté par défaut) #}
    <div class="container py-4 vault-secure-content">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

          <h1 class="mb-4 d-flex align-items-center">
            <i class="ri-lock-fill text-primary me-2" aria-hidden="true"></i>
            Nouveau souvenir privé
          </h1>

          {% include 'app/vault/_form.html.twig' with { form: form } only %}
        
        </div>
      </div>
    </div>
  {% endif %}
{% endblock %}

{% block js %}
  <script src="{{ asset('js/pages/app/journal.js') }}"></script>
  <script src="{{ asset('js/pages/app/vault.js') }}"></script>
{% endblock %}